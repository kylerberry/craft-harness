{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"testRunner": "tap",
	"tap": {
		"testFiles": ["test/**/*.test.ts"],
		"nodeArgs": ["--test-reporter=tap", "--experimental-strip-types"]
	},
	"mutate": ["src/**/*.ts"],
	"reporters": ["progress", "clear-text"],
	"coverageAnalysis": "perTest",
	"timeoutMS": 20000
}
